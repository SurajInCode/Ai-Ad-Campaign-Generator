#!/bin/sh
# Remove Cursor attribution trailers so cursoragent does not appear as a co-author on GitHub.
COMMIT_MSG_FILE=$1
[ -f "$COMMIT_MSG_FILE" ] || exit 0

sed -i '/^Co-authored-by: Cursor/d' "$COMMIT_MSG_FILE"
sed -i '/^Made-with: Cursor/d' "$COMMIT_MSG_FILE"
sed -i '/^Made with Cursor/d' "$COMMIT_MSG_FILE"

exit 0
