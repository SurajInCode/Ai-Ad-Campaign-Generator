# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/ad_campaign_generator

# Hugging Face token (REQUIRED)
# 1. Go to https://huggingface.co/settings/tokens
# 2. Create new token → enable "Make calls to Inference Providers"
# 3. Copy token (starts with hf_) and paste below — replace the line entirely
HF_TOKEN=

# CORS — comma-separated frontend URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
